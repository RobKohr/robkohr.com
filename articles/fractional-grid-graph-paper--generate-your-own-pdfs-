    <h2><a href="articles/fractional-grid-graph-paper--generate-your-own-pdfs-">Fractional grid graph paper (generate your own PDFs)</a></h2>
    <div class="variables">
    <div class="date">@date=2026-10-09</div>
    <div class="tags">@tags=<a href="tags/graph-paper">graph-paper</a>, <a href="tags/pdf">pdf</a>, <a href="tags/python">python</a>, <a href="tags/print">print</a></div>
